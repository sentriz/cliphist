! exec cliphist
! stdout .
stderr '^Usage:'
stderr '^Options:'

! exec cliphist hello
! stdout .
stderr '^Usage:'
stderr '^Options:'

! exec cliphist -unknown
! stdout .
stderr '^Usage:'
stderr '^Options:'

# flags must come before the command
! exec cliphist store -max-items 20
! stdout .
stderr '^Usage:'

! exec cliphist store --max-items 20
! stdout .
stderr '^Usage:'

! exec cliphist wipe extra
! stdout .
stderr '^Usage:'

# should store first
! exec cliphist list
stderr 'please store something first'

exec rand 16
exec cliphist store

# delete query
! exec cliphist delete-query
! stdout .
stderr '^Usage:'

# decode id check
! exec cliphist decode
! stdout .
stderr 'input not prefixed with id'

# invalid id
stdin in-invalid-id
! exec cliphist decode
! stdout .
stderr 'parsing "a": invalid syntax'

-- in-invalid-id --
a	x
